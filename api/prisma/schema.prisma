generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, vector]
}

model Node {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  kind        NodeKind
  slug        String
  title       String
  summary     String?
  bodyMdx     String?  @map("body_mdx")
  bodyPlain   String?  @map("body_plain")
  seo         Json?
  metadata    Json?
  status      NodeStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  revisions     NodeRevision[]
  tags          TagsXref[]
  srcEdges      Edge[]         @relation("SourceNode")
  dstEdges      Edge[]         @relation("DestinationNode")
  chunks        DocumentChunk[]
  siteIncludes  SitesXref[]

  @@unique([kind, slug], name: "uq_kind_slug")
  @@index([publishedAt(sort: Desc)])
  @@map("nodes")
}

model NodeRevision {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nodeId    String   @map("node_id") @db.Uuid
  version   Int
  snapshot  Json
  authorId  String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, version], name: "uq_node_version")
  @@map("node_revisions")
}

model Tag {
  slug       String  @id
  label      String
  facet      TagFacet?
  parentSlug String? @map("parent_slug")

  parent   Tag?        @relation("TagHierarchy", fields: [parentSlug], references: [slug])
  children Tag[]       @relation("TagHierarchy")
  nodes    TagsXref[]

  @@map("tags")
}

model TagsXref {
  nodeId  String @map("node_id") @db.Uuid
  tagSlug String @map("tag_slug")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagSlug], references: [slug], onDelete: Cascade)

  @@id([nodeId, tagSlug])
  @@index([tagSlug])
  @@map("tags_xref")
}

model Edge {
  src      String  @db.Uuid
  dst      String  @db.Uuid
  kind     String
  weight   Float   @default(1.0)
  metadata Json?

  srcNode Node @relation("SourceNode", fields: [src], references: [id], onDelete: Cascade)
  dstNode Node @relation("DestinationNode", fields: [dst], references: [id], onDelete: Cascade)

  @@id([src, dst, kind])
  @@index([src])
  @@index([dst])
  @@map("edges")
}

model DocumentChunk {
  id        String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nodeId    String                     @map("node_id") @db.Uuid
  ord       Int
  content   String
  meta      Json?
  embedding Unsupported("vector(1536)")?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("document_chunks")
}

model Site {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug         String   @unique
  domain       String?  @unique
  theme        Json?
  includeTags  String[] @map("include_tags")
  includeNodes String[] @map("include_nodes") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  nodeIncludes SitesXref[]

  @@index([domain])
  @@map("sites")
}

model SitesXref {
  siteId String     @map("site_id") @db.Uuid
  nodeId String     @map("node_id") @db.Uuid
  reason SiteReason

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([siteId, nodeId])
  @@map("sites_xref")
}

model AuditLog {
  id      BigInt   @id @default(autoincrement())
  ts      DateTime @default(now()) @db.Timestamptz
  actorId String?  @map("actor_id") @db.Uuid
  action  String
  payload Json?
  traceId String?  @map("trace_id")

  @@map("audit_log")
}

enum NodeKind {
  ARTICLE @map("article")
  BLOG    @map("blog")
  PERSON  @map("person")
  COMPANY @map("company")
  PROJECT @map("project")
  ASSET   @map("asset")

  @@map("node_kind")
}

enum NodeStatus {
  DRAFT     @map("draft")
  IN_REVIEW @map("in_review")
  PUBLISHED @map("published")

  @@map("node_status")
}

enum TagFacet {
  INDUSTRY @map("industry")
  ROLE     @map("role")
  REGION   @map("region")
  SCALE    @map("scale")
  KEYWORD  @map("keyword")

  @@map("tag_facet")
}

enum SiteReason {
  PIN     @map("pin")
  EXCLUDE @map("exclude")

  @@map("site_reason")
}